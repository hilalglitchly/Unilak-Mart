# Salin menjadi .env.local lalu isi dari Supabase Dashboard -> Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL dasar aplikasi (lokal: http://localhost:3000, produksi: URL Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opsional: kunci rahasia untuk mengamankan endpoint cron /api/cron/maintenance
CRON_SECRET=
